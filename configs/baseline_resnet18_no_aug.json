{
  "experiment_name": "baseline_resnet18_no_aug",
  "random_seed": 42,
  "model": {
    "architecture": "resnet18",
    "pretrained_weights": "torchvision.models.ResNet18_Weights.IMAGENET1K_V1",
    "num_classes": 6
  },
  "classes": [
    "crazing",
    "inclusion",
    "patches",
    "pitted_surface",
    "rolled_in_scale",
    "scratches"
  ],
  "label_aliases": {
    "rolled-in_scale": "rolled_in_scale"
  },
  "split_dir": "data/splits/seed_42_70_15_15",
  "preprocessing": {
    "input_size": 224,
    "normalization": {
      "mean": [0.485, 0.456, 0.406],
      "std": [0.229, 0.224, 0.225],
      "source": "ImageNet pretrained torchvision weights"
    },
    "train_transforms": {
      "resize": 224,
      "random_rotation_degrees": 0,
      "horizontal_flip_probability": 0.0,
      "vertical_flip_probability": 0.0,
      "color_jitter": {
        "brightness": 0.0,
        "contrast": 0.0,
        "saturation": 0.0,
        "hue": 0.0
      }
    },
    "validation_transforms": {
      "resize": 224
    },
    "test_transforms": {
      "resize": 224
    }
  },
  "training": {
    "epochs": 5,
    "batch_size": 32,
    "learning_rate": 0.0001,
    "optimizer": "AdamW",
    "weight_decay": 0.0001,
    "num_workers": 0
  },
  "outputs": {
    "results_dir": "results/experiments/baseline_resnet18_no_aug",
    "checkpoint_dir": "checkpoints/baseline_resnet18_no_aug"
  }
}
